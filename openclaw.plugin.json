{
  "id": "openclaw-memu",
  "kind": "memory",
  "uiHints": {
    "serverUrl": {
      "label": "memU Server URL",
      "placeholder": "http://localhost:8000",
      "help": "Where memU-server is listening over HTTP"
    },
    "userId": {
      "label": "User ID",
      "placeholder": "willie",
      "help": "Required primary scope for the memU memory pool"
    },
    "agentId": {
      "label": "Agent ID",
      "placeholder": "rei",
      "help": "Optional secondary scope for separating agent or runtime memory pools"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Retrieve and inject relevant memories through OpenClaw's memory prompt supplement"
    },
    "autoCapture": {
      "label": "Capture Helper Enabled",
      "help": "Controls capture through memu_store and memu.memorize. Automatic post-turn capture is not wired in the current 5.x integration."
    },
    "recallTopK": {
      "label": "Recall Top K",
      "advanced": true,
      "placeholder": "3"
    },
    "recallMaxChars": {
      "label": "Recall Query Max Chars",
      "advanced": true,
      "placeholder": "1000"
    },
    "captureMaxChars": {
      "label": "Capture Max Chars",
      "advanced": true,
      "placeholder": "500"
    },
    "recallTimeoutMs": {
      "label": "Recall Timeout (ms)",
      "advanced": true,
      "placeholder": "15000"
    },
    "captureMaxMessagesPerTurn": {
      "label": "Capture Max Messages/Call",
      "advanced": true,
      "placeholder": "3"
    },
    "retrieveMethod": {
      "label": "Retrieve Method",
      "advanced": true,
      "help": "rag = vector retrieval; llm = LLM-mediated retrieval"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["serverUrl", "userId"],
    "properties": {
      "serverUrl": { "type": "string", "format": "uri" },
      "userId": { "type": "string", "minLength": 1 },
      "agentId": { "type": "string" },
      "autoRecall": { "type": "boolean", "default": true },
      "autoCapture": { "type": "boolean", "default": true },
      "recallTopK": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
      "recallMaxChars": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 1000 },
      "captureMaxChars": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 500 },
      "recallTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 15000 },
      "captureMaxMessagesPerTurn": { "type": "integer", "minimum": 1, "maximum": 50, "default": 3 },
      "retrieveMethod": { "type": "string", "enum": ["rag", "llm"], "default": "rag" }
    }
  }
}
