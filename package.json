{
  "name": "@grimmjoww/openclaw-memu",
  "version": "0.1.0",
  "description": "OpenClaw memory plugin backed by memU-server. Auto-recall before each turn, auto-capture after.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.49"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "install": {
      "npmSpec": "@grimmjoww/openclaw-memu",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.2"
    },
    "compat": {
      "pluginApi": ">=2026.5.2"
    },
    "build": {
      "openclawVersion": "2026.5.2"
    }
  }
}
